# Copy to .env and fill in real values. Never commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# --- PostgreSQL ---
POSTGRES_DB=newfies
POSTGRES_USER=newfies
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- FreeSWITCH (external - not part of this compose stack) ---
ESL_HOSTNAME=host.docker.internal
ESL_PORT=8021
ESL_SECRET=ClueCon
API_ALLOWED_IP=127.0.0.1

# --- nginx ---
HTTP_PORT=8000

# --- Default admin account (auto-created/ensured by web on every startup) ---
CREATE_DEFAULT_SUPERUSER=true
DEFAULT_SUPERUSER_USERNAME=admin
DEFAULT_SUPERUSER_PASSWORD=admin123
DEFAULT_SUPERUSER_EMAIL=admin@example.com

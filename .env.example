# Copy to .env and fill in real values. Never commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# --- PostgreSQL ---
POSTGRES_DB=newfies
POSTGRES_USER=newfies
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- FreeSWITCH (docker/freeswitch/Dockerfile, network_mode: host) ---
ESL_HOSTNAME=host.docker.internal
ESL_PORT=8021
# Change this - the freeswitch service listens on 0.0.0.0 (not just
# localhost), since it's reached from other containers via host.docker.internal.
ESL_SECRET=change-me
API_ALLOWED_IP=127.0.0.1
TTS_ENGINE=flite

# --- nginx ---
HTTP_PORT=8000

# --- Default admin account (auto-created/ensured by web on every startup) ---
CREATE_DEFAULT_SUPERUSER=true
DEFAULT_SUPERUSER_USERNAME=admin
DEFAULT_SUPERUSER_PASSWORD=admin123
DEFAULT_SUPERUSER_EMAIL=admin@example.com
